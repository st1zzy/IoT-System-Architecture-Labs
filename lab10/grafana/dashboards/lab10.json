{
 "uid": "lab10",
 "title": "Lab 10 — Scalable IoT",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Подключения по узлам EMQX",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "emqx_connections_count",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Сообщения/с: принято брокером",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(emqx_messages_received[30s])",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Ingest: строк/с в TimescaleDB",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ingest_rows_total[30s]))",
     "legendFormat": "всего"
    },
    {
     "refId": "B",
     "expr": "rate(ingest_rows_total[30s])",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Отброшено брокером, сообщений/с",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(emqx_delivery_dropped_queue_full[30s])",
     "legendFormat": "queue_full {{instance}}"
    },
    {
     "refId": "B",
     "expr": "rate(emqx_messages_dropped_no_subscribers[30s])",
     "legendFormat": "no_subscribers {{instance}}"
    }
   ]
  }
 ]
}