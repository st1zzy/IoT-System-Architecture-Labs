.venv/
__pycache__/
*.pyc

# Рабочие данные брокера (создаются при запуске стенда)
*/mosquitto/data/*
!*/mosquitto/data/.gitkeep
*/mosquitto/log/*
!*/mosquitto/log/.gitkeep

# Временные файлы Word
~$*.docx
node_modules/

# Постоянно работающий стенд (не эксперимент)
*/results/collector/live/

# Сертификаты Lab 2 генерируются при запуске
*/certs/

# Lab 4: пароли генерируются при запуске
lab4/secrets/
lab4/broker-a/config/passwd

# Lab 9: PKI (закрытые ключи CA и устройств) генерируется скриптом и не хранится в Git
lab9/pki/
lab9/ota/keys/
lab9/ota/out/
