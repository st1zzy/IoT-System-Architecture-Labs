{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/st1zzy/IoT-System-Architecture-Labs/lab1/schema/telemetry.schema.json",
  "title": "Telemetry message v1",
  "description": "Сообщение телеметрии устройства уровня Device Layer (Lab 1). Одинаково для JSON и CBOR.",
  "type": "object",
  "required": ["schema_version", "device_id", "ts", "seq", "metrics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Версия формата: мажорная 1, минорные изменения обратно совместимы",
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "device_id": {
      "description": "Идентификатор устройства",
      "type": "string",
      "pattern": "^[a-z0-9-]{3,32}$"
    },
    "ts": {
      "description": "device_ts: момент измерения по часам устройства, мс с 1970-01-01 UTC",
      "type": "integer",
      "minimum": 1577836800000,
      "maximum": 4102444800000
    },
    "seq": {
      "description": "Номер сообщения с момента включения, растёт на 1",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "metrics": {
      "type": "object",
      "required": ["temperature", "humidity", "pressure", "motion"],
      "additionalProperties": false,
      "properties": {
        "temperature": { "description": "°C; null — значение отбраковано на устройстве", "type": ["number", "null"], "minimum": -40, "maximum": 85 },
        "humidity":    { "description": "% RH", "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "pressure":    { "description": "гПа", "type": ["number", "null"], "minimum": 300, "maximum": 1100 },
        "motion":      { "description": "PIR: было ли движение за интервал опроса", "type": ["boolean", "null"] }
      }
    },
    "battery": { "description": "Заряд батареи, %", "type": "number", "minimum": 0, "maximum": 100 },
    "rssi":    { "description": "Уровень сигнала, дБм", "type": "integer", "minimum": -120, "maximum": 0 },
    "quality": {
      "description": "Флаги валидации на устройстве; присутствует, только если есть флаги",
      "type": "object",
      "propertyNames": { "enum": ["temperature", "humidity", "pressure", "motion"] },
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["nan", "out_of_range", "spike", "stuck"] }
      }
    }
  }
}
